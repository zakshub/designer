{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/source.schema.json",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/metadata"
    }
  ],
  "type": "object",
  "required": [
    "source_type",
    "locator",
    "creator",
    "publisher",
    "independence_group",
    "captured_at",
    "strength",
    "rights"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^source_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "const": "source"
    },
    "source_type": {
      "enum": [
        "standard",
        "research",
        "publication",
        "expert",
        "project",
        "internal"
      ]
    },
    "locator": {
      "type": "string",
      "format": "uri"
    },
    "creator": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "independence_group": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "strength": {
      "enum": [
        "primary",
        "secondary",
        "weak"
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "permitted",
            "metadata-only",
            "prohibited",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
